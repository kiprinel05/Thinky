# API Configuration
# Pentru testare pe telefon real, folosește IP-ul PC-ului
# Exemplu: API_BASE_URL=http://192.168.1.100:8000
# Pentru emulator Android: API_BASE_URL=http://10.0.2.2:8000
# Pentru web/Chrome: API_BASE_URL=http://localhost:8000

API_BASE_URL=http://localhost:8000

# Debug flags (set to false or remove for production builds)
DEBUG_MODE=false
USE_OFFLINE_MISSIONS=false
